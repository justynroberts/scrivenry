# Copy to .env and fill in. Every .env variant is gitignored — never commit real
# values. This example is the only file in that family that belongs in git.

# Database
DATABASE_URL="file:/app/data/scrivenry.db"

# Authentication
# REQUIRED. There is no default — the app throws if this is unset, because a
# signing key baked into the source can forge a session token on any
# deployment that did not override it.
# Generate with: openssl rand -base64 32
JWT_SECRET=""

# Security
AUTH_SECURE_COOKIES="true"

# CSRF protection (optional, falls back to JWT_SECRET)
# Generate: openssl rand -base64 32
CSRF_SECRET=""

# First admin account. Created on startup only when BOTH are set and the
# account does not already exist; otherwise register through the UI.
# Password must be at least 8 characters. There is no default account.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
